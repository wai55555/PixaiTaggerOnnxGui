{
  "model_id": "camie_tagger_v2",
  "model_name": "camie-tagger-v2",
  "model_type": "tagger",
  "license": "GPL-3.0",
  "network": {
    "files": {
      "model.onnx": "https://huggingface.co/Camais03/camie-tagger-v2/resolve/main/camie-tagger-v2.onnx",
      "camie-tagger-v2-metadata.json": "https://huggingface.co/Camais03/camie-tagger-v2/resolve/main/camie-tagger-v2-metadata.json"
    },
    "hash_verified_file": "model.onnx"
  },
  "inference": {
    "input_size": 512,
    "layout": "nchw",
    "channel_order": "rgb",
    "rescale_to_unit": true,
    "pad_color_rgb": [
      124,
      116,
      104
    ],
    "normalize_mean": [
      0.485,
      0.456,
      0.406
    ],
    "normalize_std": [
      0.229,
      0.224,
      0.225
    ],
    "extra_inputs": [],
    "output_name": "refined_predictions",
    "output_activation": "sigmoid"
  },
  "tags_csv": {
    "format": "camie_metadata_json",
    "file_name": "camie-tagger-v2-metadata.json",
    "default_category": "general"
  },
  "ui": {
    "supports_character_tag": true,
    "supports_threshold_slider": true,
    "default_threshold": 0.61,
    "categories": [
      "general",
      "character",
      "copyright",
      "artist",
      "rating",
      "meta",
      "year"
    ]
  }
}
