      0.5,
      0.5
    ],
    "extra_inputs": [
      "padding_mask"
    ],
    "output_name": "probabilities",
    "output_activation": "none"
  },
  "tags_csv": {
    "format": "simple3col",
    "default_category": "general"
  },
  "ui": {
    "supports_character_tag": false,
    "supports_threshold_slider": true,
    "default_threshold": 0.5,
    "categories": [
      "general"
    ]
  }
