{
  "model_id": "oppaioracle_v1_1",
  "model_name": "OppaiOracle V1.1",
  "model_type": "tagger",
  "license": "Apache-2.0",
  "network": {
    "files": {
      "model.onnx": "https://huggingface.co/Grio43/OppaiOracle/resolve/main/V1.1_onnx/model.onnx",
      "selected_tags.csv": "https://huggingface.co/Grio43/OppaiOracle/resolve/main/V1.1_onnx/selected_tags.csv",
      "vocabulary.json": "https://huggingface.co/Grio43/OppaiOracle/resolve/main/V1.1_onnx/vocabulary.json",
      "pr_thresholds.json": "https://huggingface.co/Grio43/OppaiOracle/resolve/main/V1.1_onnx/pr_thresholds.json"
