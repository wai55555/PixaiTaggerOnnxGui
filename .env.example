# VLM provider API keys. Copy this file to ".env" (same folder) and fill in.
# The app reads .env on startup; keys here feed vlm_secrets (env-var tier),
# so you don't have to register each one in the "Register API key" dialog.
# Lines starting with # are ignored. Do not commit your real .env.

GEMINI_API_KEY=
# GOOGLE_API_KEY=  # Alternative to GEMINI_API_KEY
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
# CF_API_TOKEN=  # Alternative to CLOUDFLARE_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=
GROQ_API_KEY=
NVIDIA_API_KEY=
# NVIDIA_NIM_API_KEY=  # Alternative to NVIDIA_API_KEY
HF_TOKEN=
# HUGGINGFACEHUB_API_TOKEN=  # Alternative to HF_TOKEN
AI_GATEWAY_API_KEY=
# VERCEL_AI_GATEWAY_API_KEY=  # Alternative to AI_GATEWAY_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# MISTRAL_API_KEY=  # Built-in Mistral route is currently disabled.
