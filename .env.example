# VLM provider API keys. Copy this file to ".env" (same folder) and fill in.
# The app reads .env on startup; keys here feed vlm_secrets (env-var tier),
# so you don't have to register each one in the "Register API key" dialog.
# Lines starting with # are ignored. Do not commit your real .env.

GEMINI_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GROQ_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
